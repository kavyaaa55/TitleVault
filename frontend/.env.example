# ==============================================================
# Frontend Environment Configuration (.env)
# ==============================================================

# Backend API Endpoints
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Blockchain Network Configuration
# For Sepolia: Chain ID 11155111
# For Local Hardhat Node: Chain ID 31337
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
VITE_BLOCK_EXPLORER=https://sepolia.etherscan.io

# Deployed Contract Addresses
VITE_REGISTRY_CONTRACT=0x0000000000000000000000000000000000000000
VITE_AGREEMENT_CONTRACT=0x0000000000000000000000000000000000000000

# Mapbox Access Token (public token starting with pk.eyJ...)
VITE_MAPBOX_TOKEN=pk.eyJ1...

# Map Defaults
VITE_DEFAULT_MAP_CENTER_LAT=40.7128
VITE_DEFAULT_MAP_CENTER_LNG=-74.0060
VITE_DEFAULT_MAP_ZOOM=10

# UI Feature Toggles
VITE_ENABLE_SPATIAL_FEATURES=true
VITE_ENABLE_COURT_FEATURES=true
VITE_ENABLE_FRAUD_DETECTION=true
